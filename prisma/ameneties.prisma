model Ameneties {
	id String @id @default(uuid())
	amenetiesName String 
	count Int? 
	otherFeatures String? 
	createdAt DateTime @default(now())
	updatedAt DateTime @updatedAt
	Property Property? @relation(name: "AmenetiesToProperty")

    @@map("ameneties")
}

model Property {
    id String @id @default(uuid())
	propertyAmeneties String? @unique
	amenities Ameneties? @relation(name: "AmenetiesToProperty", fields: [propertyAmeneties], references: [id])

}