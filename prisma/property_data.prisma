model Porperty_data {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  imageKey   String?   @default("NA")
  type       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Property Property @relation(fields: [propertyId], references: [id])
  @@map("properties_data")
}

model Property{
    id String @id @default(uuid())
    PropertyData Porperty_data[]
    
}