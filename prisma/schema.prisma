// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model preferences {
  id                String    @id @default(uuid())
  userId            String?   @unique
  emailNotification Boolean
  newsLetter        Boolean
  automatedReport   Boolean
  currency          String
  areaUnit          String
  created_at        DateTime  @default(now())
  updated_at        DateTime?

  user User? @relation(fields: [userId], references: [id])
}

model User {
  id                 String   @id @default(uuid())
  firstName          String
  lastName           String
  email              String   @unique
  mobileNumber       String   @unique
  landlineNumber     String?
  whatsapp           String?
  country            String?
  address            String?
  password           String?
  isVerified         Boolean  @default(false)
  socialId           String?
  socialLogin        Boolean  @default(false)
  role               String?  @default("user")
  profileImage       String?
  imageKey           String?   
  profileVisibility  Boolean  @default(false)
  passwordResetToken String?
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  property    Property[]
  preferences preferences?
}

model Porperty_data {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  imageKey   String   @default("property")
  type       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  Property Property @relation(fields: [propertyId], references: [id])
}

model Cities {
  id         String   @id @default(uuid())
  cityName   String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Ameneties {
  id            String   @id @default(uuid())
  amenetiesName String
  count         Int?
  otherFeatures String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  Property Property?
}

model Property {
  id                  String   @id @default(uuid())
  user                User?    @relation(fields: [userId], references: [id])
  userId              String?
  propertyName        String
  propertyType        String?
  subType             String?
  propertyPrice       Int?
  propertyArea        String?
  purpose             String?
  propertyAddress     String?
  propertyCity        String?
  propertyZip         String?
  propertyDescription String?
  propertyAmeneties   String?  @unique
  longitude           String?
  latitude            String?
  propertyBy          String?
  proposalCount      Int?     @default(0)
  propertyStatus     Boolean? @default(false)
  isFeatured          Boolean? @default(false)

  PropertyData Porperty_data[]

  amenities            Ameneties? @relation(fields: [propertyAmeneties], references: [id])
  userPropertyBidding  Bidding[]  @relation("UserProperty")
  agentPropertyBidding Bidding[]  @relation("AgentProperty")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Bidding {
  id              String  @id @default(uuid())
  userPropertyId  String
  agentPropertyId String
  agentStatus     String? @default("submitted")
  userStatus      String? @default("pending")

  userProperty Property? @relation("UserProperty", fields: [userPropertyId], references: [id])

  agentProperty Property? @relation("AgentProperty", fields: [agentPropertyId], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}
