// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model preferences {
  id                 Int       @id @default(autoincrement())
  user_id            Int?      @unique
  email_notification Boolean
  newsletter         Boolean
  automated_report   Boolean
  currency           String
  area_unit          String
  created_at         DateTime  @default(now())
  updated_at         DateTime?

  user User? @relation(fields: [user_id], references: [id])
}

model User {
  id                   Int       @id @default(autoincrement())
  first_name           String
  last_name            String
  email                String    @unique
  mobile_number        String
  landline_number      String?
  whatsapp             String?
  country              String?
  address              String?
  password             String?
  isVerified           Boolean   @default(false)
  social_id            String?
  social_login         Boolean   @default(false)
  role                 String?   @default("user")
  profile_image        String?
  profile_visibility   Boolean   @default(false)
  password_reset_token String?
  created_at           DateTime  @default(now())
  updated_at           DateTime?

  property    Property[]
  preferences preferences?
}

model Porperty_data {
  id          Int       @id @default(autoincrement())
  property_id Int
  url         String
  type        String
  created_at  DateTime  @default(now())
  updated_at  DateTime?

  Property Property @relation(fields: [property_id], references: [id])
}

model Cities {
  id         Int       @id @default(autoincrement())
  city_name  String
  created_at DateTime  @default(now())
  updated_at DateTime?
}

model Ameneties {
  id             Int       @id @default(autoincrement())
  ameneties_name String
  count          Int?
  other_features String?
  created_at     DateTime  @default(now())
  updated_at     DateTime?

  Property Property?
}

model Property {
  id                   Int       @id @default(autoincrement())
  user                 User?     @relation(fields: [user_id], references: [id])
  user_id              Int?
  property_name        String
  property_type        String?
  sub_type             String?
  property_price       Int?
  property_area        String?
  purpose              String?
  property_address     String?
  property_city        String?
  property_zip         String?
  property_description String?
  property_ameneties   Int?      @unique
  longitude            String?
  latitude             String?
  property_by          String?
  proposal_count       Int?     @default(0)
  property_status      Boolean?  @default(false)
  isFeatured           Boolean?  @default(false)
  

  Property_data Porperty_data[]

  amenities            Ameneties? @relation(fields: [property_ameneties], references: [id])
  userPropertyBidding  Bidding[]  @relation("UserProperty")
  agentPropertyBidding Bidding[]  @relation("AgentProperty")

  created_at           DateTime  @default(now())
  updated_at           DateTime?
}

model Bidding {
  id                Int    @id @default(autoincrement())
  user_property_id  Int
  agent_property_id Int
  agent_status            String? @default("submitted")
  user_status            String? @default("pending")
  

  userProperty Property? @relation("UserProperty", fields: [user_property_id], references: [id])

  agentProperty Property? @relation("AgentProperty", fields: [agent_property_id], references: [id])

  created_at DateTime  @default(now())
  updated_at DateTime?
}
